{
  "name": "radix-way",
  "version": "1.6.2",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsdown",
    "lint": "eslint \"./{src,tests}/**/*.{ts,js}\" --fix",
    "test": "vitest run",
    "demo": "bun run demo.ts",
    "format": "prettier --write \"./{src,tests}/**/*.{ts,js}\"",
    "release": "bun run build && npm publish",
    "check-types": "tsc --noEmit",
    "bench:bun": "cd bench && bun run bench:bun",
    "bench:node": "cd bench && bun run bench:node"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "unplugin-unused": "^0.6.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vajra-Labs/radix-way.git"
  },
  "keywords": [
    "router",
    "radix-tree",
    "radix",
    "trie",
    "http-router",
    "routing",
    "url-router",
    "path-matching",
    "middleware",
    "express",
    "hono",
    "fastify",
    "performance",
    "fast-router",
    "parametric-routes",
    "wildcard",
    "regex-routes",
    "typescript",
    "lightweight"
  ],
  "homepage": "https://github.com/Vajra-Labs/radix-way#readme",
  "license": "MIT",
  "author": "Aashish Panchal <aipanchal51@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@swc/core"
  ]
}
